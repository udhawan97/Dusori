---
import '../styles/global.css';
import '../styles/landing.css';

import {
  appBasePath,
  docsBasePath,
  hostedProjectUrl,
  projectBasePath,
} from '../../../../config/site.mjs';

const releaseVersion = '0.13.0';
const appHref = `${appBasePath}/`;
const docsHref = `${docsBasePath}/`;
const githubHref = 'https://github.com/udhawan97/Dusori';
const releaseHref = `${githubHref}/releases/tag/v${releaseVersion}`;
const releaseAssetHref = `${githubHref}/releases/download/v${releaseVersion}`;
const macArmInstallerHref = `${releaseAssetHref}/Dusori_${releaseVersion}_aarch64-aarch64-apple-darwin.dmg`;
const windowsInstallerHref = `${releaseAssetHref}/Dusori_${releaseVersion}_x64-setup-x86_64-pc-windows-msvc.exe`;
const sourceHref = `${githubHref}/archive/refs/tags/v${releaseVersion}.zip`;
const appIconHref = `${projectBasePath}/brand/dusori-app-icon.svg`;
const researchShot = `${projectBasePath}/app-research.png`;
const readerShot = `${projectBasePath}/app-reader.png`;
const mapShot = `${projectBasePath}/app-map.png`;
const socialImageHref = `${hostedProjectUrl}og-dusori.png`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; base-uri 'self'; object-src 'none'; img-src 'self'; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    />
    <meta name="theme-color" content="#f7f1e8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14100d" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={`${projectBasePath}/favicon.svg`} type="image/svg+xml" />
    <link rel="canonical" href={hostedProjectUrl} />
    <meta
      name="description"
      content="Dusori is a private research desk that routes each question to relevant permitted sources, saves a durable evidence trail, and builds an honest local brief."
    />
    <meta property="og:type" content="website" />
    <meta
      property="og:title"
      content="Dusori — ask a hard question, get an honest research brief"
    />
    <meta
      property="og:description"
      content="Route locally, ask permission, search, read, synthesize, and inspect the source trail. No account, no telemetry, ordinary local files."
    />
    <meta property="og:url" content={hostedProjectUrl} />
    <meta property="og:image" content={socialImageHref} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Dusori evidence trail from a hard question to a cited local brief"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <title>Dusori — a calm, honest research desk</title>
  </head>
  <body>
    <svg class="icon-defs" aria-hidden="true" focusable="false">
      <defs>
        <symbol id="i-arrow" viewBox="0 0 24 24"><path d="M5 12h13m-5-5 5 5-5 5"></path></symbol>
        <symbol id="i-browser" viewBox="0 0 24 24"
          ><rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="M3 8h18M6 6h.01M9 6h.01"
          ></path></symbol
        >
        <symbol id="i-download" viewBox="0 0 24 24"
          ><path d="M12 3v12m-5-5 5 5 5-5M4 20h16"></path></symbol
        >
        <symbol id="i-book" viewBox="0 0 24 24"
          ><path
            d="M4 5.5A2.5 2.5 0 0 1 6.5 3H11v16H6.5A2.5 2.5 0 0 0 4 21.5zm16 0A2.5 2.5 0 0 0 17.5 3H13v16h4.5a2.5 2.5 0 0 1 2.5 2.5z"
          ></path></symbol
        >
        <symbol id="i-source" viewBox="0 0 24 24"
          ><path d="M6 3h8l4 4v14H6zM14 3v4h4M9 12h6m-6 4h4"></path></symbol
        >
        <symbol id="i-map" viewBox="0 0 24 24"
          ><circle cx="6" cy="17" r="2"></circle><circle cx="12" cy="6" r="2"></circle><circle
            cx="18"
            cy="16"
            r="2"></circle><path d="m7 15 4-7m2 0 4 6M8 17l8-1"></path></symbol
        >
        <symbol id="i-lock" viewBox="0 0 24 24"
          ><rect x="4" y="10" width="16" height="11" rx="2"></rect><path d="M8 10V7a4 4 0 0 1 8 0v3"
          ></path></symbol
        >
        <symbol id="i-check" viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"></path></symbol>
        <symbol id="i-update" viewBox="0 0 24 24"
          ><path d="M20 7v5h-5M4 17v-5h5"></path><path
            d="M6.1 8A7 7 0 0 1 18 6l2 6M17.9 16A7 7 0 0 1 6 18l-2-6"></path></symbol
        >
      </defs>
    </svg>

    <header class="site-nav">
      <a class="brand" href={`${projectBasePath}/`} aria-label="Dusori home">
        <picture>
          <source
            media="(prefers-color-scheme: dark)"
            srcset={`${projectBasePath}/brand/dusori-mark-reversed.svg`}
          />
          <img src={`${projectBasePath}/brand/dusori-mark.svg`} alt="" width="30" height="30" />
        </picture>
        <span>Dusori</span>
      </a>
      <nav aria-label="Primary">
        <a href={docsHref}>Docs</a>
      </nav>
      <a class="button button--small" href={appHref}>
        <svg aria-hidden="true"><use href="#i-browser"></use></svg> Open app
      </a>
    </header>

    <main>
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow"><span>v{releaseVersion}</span> Private research desk</p>
          <h1 id="hero-title">Ask a hard question. Follow the evidence.</h1>
          <p class="lede">
            Dusori chooses relevant sources on your device, asks permission, saves a varied evidence
            shelf, and builds one cited brief. Your sources, notes, and map stay local.
          </p>
          <div class="actions">
            <a class="button button--primary" href={appHref}
              ><svg aria-hidden="true"><use href="#i-browser"></use></svg> Open in browser</a
            >
            <a class="button" href="#downloads"
              ><svg aria-hidden="true"><use href="#i-download"></use></svg> Download app</a
            >
          </div>
          <p class="trust-line">
            No account · no telemetry · no hosted workspace · useful without AI
          </p>
        </div>
        <div class="hero-stage">
          <a class="app-icon-module" href="#how">
            <span class="app-icon-shell">
              <span class="app-icon-depth app-icon-depth--back" aria-hidden="true"></span>
              <span class="app-icon-depth app-icon-depth--middle" aria-hidden="true"></span>
              <img
                class="app-icon-face"
                src={appIconHref}
                alt="Dusori app icon with an open ensō, rangoli geometry, and katana on warm paper"
                width="512"
                height="512"
              />
            </span>
            <span class="app-icon-copy">
              <strong>One icon. One evidence trail.</strong>
              <span>Begin with the complete research path <span aria-hidden="true">↓</span></span>
            </span>
          </a>

          <figure class="hero-figure">
            <img
              src={researchShot}
              alt="Dusori Research Desk with a question, provider outcomes, and saved evidence"
              width="1440"
              height="960"
              fetchpriority="high"
            />
            <figcaption>
              <span>Research</span><span>One question to a durable source-backed brief</span>
            </figcaption>
          </figure>
        </div>
      </section>

      <section class="promise" aria-label="Dusori places">
        <p>Four places. No mystery drawers.</p>
        <dl>
          <div><dt>Research</dt><dd>Ask, search, rank, synthesize.</dd></div>
          <div><dt>Sources</dt><dd>Read, open, remove, restore.</dd></div>
          <div><dt>Map</dt><dd>Follow Outline or evidence atlas.</dd></div>
          <div><dt>Settings</dt><dd>Choose appearance, privacy, files.</dd></div>
        </dl>
      </section>

      <nav class="site-guide" aria-label="Explore Dusori">
        <p><span>Follow one evidence trail</span> The app icon opens into four clear stops.</p>
        <ol>
          <li>
            <a href="#how"
              ><small>01 · How it works</small><strong
                >Question → Local route/consent → Search → Brief</strong
              ></a
            >
          </li>
          <li>
            <a href="#sources"
              ><small>02 · Inspect sources</small><strong
                >See what was captured, blocked, or kept local</strong
              ></a
            >
          </li>
          <li>
            <a href="#map"
              ><small>03 · Follow Trail/Map</small><strong
                >Trace the same files in Outline or atlas</strong
              ></a
            >
          </li>
          <li>
            <a href="#downloads"
              ><small>04 · Run Dusori</small><strong
                >Choose browser, desktop, companion, or source</strong
              ></a
            >
          </li>
        </ol>
      </nav>

      <section class="loop" id="how" aria-labelledby="loop-title">
        <header class="section-heading">
          <p class="eyebrow">The research loop</p>
          <h2 id="loop-title">From a question to evidence you can inspect.</h2>
          <p>Dusori can organize the research. It cannot make weak evidence strong.</p>
        </header>
        <ol class="loop-steps">
          <li>
            <span>01</span><div>
              <h3>Ask</h3><p>
                Write the question in your own words—no roadmap or objective required.
              </p>
            </div>
          </li>
          <li>
            <span>02</span><div>
              <h3>Search and save</h3><p>
                Dusori routes locally, asks only about relevant providers, and keeps a varied first
                shelf automatically.
              </p>
            </div>
          </li>
          <li>
            <span>03</span><div>
              <h3>Read or hand off</h3><p>
                Read available text locally; blocked pages keep an ordinary browser link.
              </p>
            </div>
          </li>
          <li>
            <span>04</span><div>
              <h3>Synthesize</h3><p>
                Quotable passages become a cited brief; references alone make no claims.
              </p>
            </div>
          </li>
          <li>
            <span>05</span><div>
              <h3>See the trail</h3><p>
                Outline and evidence atlas reflect the same local sources, notes, and links.
              </p>
            </div>
          </li>
        </ol>
      </section>

      <section class="reader" id="sources" aria-labelledby="reader-title">
        <figure>
          <img
            src={readerShot}
            alt="Dusori Reading room with a saved local source"
            width="1440"
            height="960"
            loading="lazy"
          />
          <figcaption>Reading room · a local copy with provenance</figcaption>
        </figure>
        <div>
          <p class="eyebrow">The evidence shelf</p>
          <h2 id="reader-title">You always know what was saved.</h2>
          <p>
            Research saves up to eight ranked results to a varied first shelf. Readable captures are
            labeled separately from browser-only references. You can remove any source from active
            research and restore it later without losing the local copy.
          </p>
          <ul>
            <li>
              <svg aria-hidden="true"><use href="#i-check"></use></svg> Provider, URL, author, date, and
              selection reason stay attached when available.
            </li>
            <li>
              <svg aria-hidden="true"><use href="#i-check"></use></svg> Failed providers remain failures
              in the research trail.
            </li>
            <li>
              <svg aria-hidden="true"><use href="#i-check"></use></svg> A source does not become progress
              until you say so.
            </li>
          </ul>
          <a class="text-link" href={`${docsHref}sources/`}
            >How sources work <svg aria-hidden="true"><use href="#i-arrow"></use></svg></a
          >
        </div>
      </section>

      <section class="map" id="map" aria-labelledby="map-title">
        <div>
          <p class="eyebrow">Evidence atlas + Outline</p>
          <h2 id="map-title">Separate the trail without losing the links.</h2>
          <p>
            Start with the accessible linear Outline, then switch to a visual atlas where each topic
            and artifact type has its own lane. Both are derived from your folders, notes, sources,
            tags, and <code>[[wikilinks]]</code>. No graph database sits between you and your files.
          </p>
          <a class="text-link" href={`${docsHref}knowledge-graph/`}
            >Read the graph contract <svg aria-hidden="true"><use href="#i-arrow"></use></svg></a
          >
        </div>
        <figure>
          <img
            src={mapShot}
            alt="Dusori Map with a readable research outline and separated visual evidence atlas"
            width="1440"
            height="960"
            loading="lazy"
          />
          <figcaption>Map · the same knowledge in two views</figcaption>
        </figure>
      </section>

      <section class="research" aria-labelledby="research-title">
        <header class="section-heading">
          <p class="eyebrow">Research with boundaries</p>
          <h2 id="research-title">The question shapes the provider shelf.</h2>
          <p>
            Each provider starts off. Local routing narrows the choice before the first request.
          </p>
        </header>
        <div class="research-ledger">
          <article>
            <span>Always local first</span><h3>Question-shaped consent</h3><p>
              A bounded on-device routing table chooses relevant rows. It cannot grant permission or
              fall back to an unrelated specialist.
            </p>
          </article>
          <article>
            <span>Works directly</span><h3>Eleven public indexes</h3><p>
              Broad knowledge, code, books, scholarly work, biomedical literature, and digitized
              primary-source records—without a provider account or key.
            </p>
          </article>
          <article>
            <span>Optional expansion</span><h3>Companion and AI</h3><p>
              Add arXiv, configured web, Reddit, YouTube metadata, or a separately consented local
              or hosted model. Deterministic research remains useful without them.
            </p>
          </article>
        </div>
        <div class="specialist-ledger" aria-label="Question-shaped specialist providers">
          <article>
            <span>Biomedical question</span>
            <h3>Europe PMC</h3>
            <p>
              Bibliographic metadata and a labeled abstract when the public record supplies one.
            </p>
          </article>
          <article>
            <span>Archives or primary sources</span>
            <h3>Library of Congress</h3>
            <p>Canonical digitized-item catalog references—never an automatic media download.</p>
          </article>
        </div>
        <ol class="run-contract" aria-label="One research run contract">
          <li><span>01</span><strong>Route</strong><small>Local relevance, then consent</small></li>
          <li><span>02</span><strong>Record</strong><small>Found, empty, or failed</small></li>
          <li><span>03</span><strong>Save</strong><small>Each capture commits alone</small></li>
          <li><span>04</span><strong>Read</strong><small>References make no claims</small></li>
          <li><span>05</span><strong>Brief</strong><small>Write or safe proposal</small></li>
        </ol>
        <p class="legal-note">
          Dusori does not bypass logins, paywalls, robots controls, or platform restrictions, and it
          does not download YouTube media. Third-party terms and quotas still apply.
          <a href={`${docsHref}research-providers/`}>Provider matrix →</a>
        </p>
      </section>

      <section class="downloads" id="downloads" aria-labelledby="downloads-title">
        <header class="section-heading">
          <p class="eyebrow">Choose your door</p>
          <h2 id="downloads-title">Browser, Mac, Windows, or source.</h2>
          <p>
            Each desktop card opens its installer. Signatures, checksums, and updater files remain
            on the <a href={releaseHref}>v{releaseVersion} release page</a>.
          </p>
        </header>
        <div class="download-grid">
          <article class="download-card featured">
            <svg aria-hidden="true"><use href="#i-browser"></use></svg>
            <h3>Browser</h3><p>No account or terminal. Install as a PWA where supported.</p>
            <a href={appHref}
              >Open Dusori <svg aria-hidden="true"><use href="#i-arrow"></use></svg></a
            >
          </article>
          <article class="download-card">
            <span class="platform">macOS</span><h3>Apple silicon</h3><p>
              For M-series Macs. macOS 12 or newer.
            </p>
            <a href={macArmInstallerHref}
              >Download Apple silicon .dmg <svg aria-hidden="true"><use href="#i-arrow"></use></svg
              ></a
            >
          </article>
          <article class="download-card">
            <span class="platform">Windows</span><h3>x64</h3><p>
              Current-user installer for 64-bit Windows.
            </p>
            <a href={windowsInstallerHref}
              >Download Windows x64 .exe <svg aria-hidden="true"><use href="#i-arrow"></use></svg
              ></a
            >
          </article>
          <article class="download-card code-card">
            <span class="platform">Node.js 24</span><h3>
              Local companion
            </h3><pre><code>npx @udhawan97/dusori@latest</code></pre>
            <a href={`${docsHref}getting-started/`}
              >Setup guide <svg aria-hidden="true"><use href="#i-arrow"></use></svg></a
            >
          </article>
          <article class="download-card">
            <span class="platform">Apache 2.0</span><h3>Source</h3><p>
              Audit, change, or build the exact v{releaseVersion} tree.
            </p>
            <a href={sourceHref}
              >Source ZIP <svg aria-hidden="true"><use href="#i-arrow"></use></svg></a
            >
          </article>
        </div>
        <aside class="warning">
          <strong>First-launch warning</strong>
          <p>
            The v{releaseVersion} Mac and Windows installers are not Apple-notarized or Microsoft code-signed,
            so Gatekeeper or SmartScreen may warn. Compare each download with the published{' '}
            <code>SHA256SUMS.txt</code>. The separate in-app updater artifacts are signed by
            Dusori's updater key.
          </p>
        </aside>
      </section>

      <section class="updates" aria-labelledby="updates-title">
        <div class="update-mark"><svg aria-hidden="true"><use href="#i-update"></use></svg></div>
        <div>
          <p class="eyebrow">Desktop updates</p>
          <h2 id="updates-title">Check. Download. Choose when to restart.</h2>
          <p>
            Settings can check GitHub on demand, or opt in to automatic checks and downloads at app
            startup. Dusori verifies the update signature, shows the version and notes, then waits.
            Nothing installs or relaunches until you choose <strong>Install and restart</strong>;
            unsaved work blocks it.
          </p>
          <p>
            A v0.12.0 or v0.12.1 desktop build needs one manual v0.13.0 install. Both affected
            versions open to a launch-time 404, so Settings is inaccessible. Normal in-app updates
            work from v0.12.2 onward.
          </p>
          <a class="text-link" href={`${docsHref}updates/`}
            >Update and recovery guide <svg aria-hidden="true"><use href="#i-arrow"></use></svg></a
          >
        </div>
      </section>

      <section class="ownership" aria-labelledby="ownership-title">
        <div>
          <p class="eyebrow">Portable by default</p>
          <h2 id="ownership-title">The exit is the same door as the entrance.</h2>
          <p>
            Markdown, text, JSON, HTML, folders, and ZIPs. Use them in Obsidian, a text editor, or
            your own tools.
          </p>
        </div>
        <pre
          aria-label="Dusori workspace structure"><code>Topics/your-topic/
├── roadmap.md
├── Notes/
├── Sources/
│   ├── manifest.json
│   └── items/
├── research.json
└── Updates/</code></pre>
      </section>
    </main>

    <footer class="site-footer">
      <div><strong>Dusori</strong><span>Your files stay yours.</span></div>
      <nav aria-label="Project">
        <a href={docsHref}>Docs</a><a href={githubHref}>GitHub</a><a href={releaseHref}
          >v{releaseVersion}</a
        ><a href={`${githubHref}/blob/main/LICENSE`}>Apache 2.0</a>
      </nav>
    </footer>
  </body>
</html>
