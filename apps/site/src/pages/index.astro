---
import '../styles/global.css';
import '../styles/landing.css';

import {
  appBasePath,
  docsBasePath,
  hostedProjectUrl,
  projectBasePath,
} from '../../../../config/site.mjs';

const releaseVersion = '0.12.0';
const appHref = `${appBasePath}/`;
const docsHref = `${docsBasePath}/`;
const githubHref = 'https://github.com/udhawan97/Dusori';
const releaseHref = `${githubHref}/releases/tag/v${releaseVersion}`;
const sourceHref = `${githubHref}/archive/refs/tags/v${releaseVersion}.zip`;
const learnShot = `${projectBasePath}/app-learn.png`;
const readerShot = `${projectBasePath}/app-reader.png`;
const mapShot = `${projectBasePath}/app-map.png`;
const socialImageHref = `${hostedProjectUrl}og-dusori.png`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; base-uri 'self'; object-src 'none'; img-src 'self'; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    />
    <meta name="theme-color" content="#f7f1e8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14100d" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={`${projectBasePath}/favicon.svg`} type="image/svg+xml" />
    <link rel="canonical" href={hostedProjectUrl} />
    <meta
      name="description"
      content="Dusori is a private learning studio that finds permitted sources, keeps what you save, guides the next step, and maps your local notes."
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Dusori — one calm place to learn a hard topic" />
    <meta
      property="og:description"
      content="Continue, read, annotate, explicitly mark learned or review, then see the map. No account, no telemetry, ordinary local files."
    />
    <meta property="og:url" content={hostedProjectUrl} />
    <meta property="og:image" content={socialImageHref} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Dusori private learning studio" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>Dusori — one calm place to learn a hard topic</title>
  </head>
  <body>
    <svg class="icon-defs" aria-hidden="true" focusable="false">
      <defs>
        <symbol id="i-arrow" viewBox="0 0 24 24"><path d="M5 12h13m-5-5 5 5-5 5"></path></symbol>
        <symbol id="i-browser" viewBox="0 0 24 24"
          ><rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="M3 8h18M6 6h.01M9 6h.01"
          ></path></symbol
        >
        <symbol id="i-download" viewBox="0 0 24 24"
          ><path d="M12 3v12m-5-5 5 5 5-5M4 20h16"></path></symbol
        >
        <symbol id="i-book" viewBox="0 0 24 24"
          ><path
            d="M4 5.5A2.5 2.5 0 0 1 6.5 3H11v16H6.5A2.5 2.5 0 0 0 4 21.5zm16 0A2.5 2.5 0 0 0 17.5 3H13v16h4.5a2.5 2.5 0 0 1 2.5 2.5z"
          ></path></symbol
        >
        <symbol id="i-source" viewBox="0 0 24 24"
          ><path d="M6 3h8l4 4v14H6zM14 3v4h4M9 12h6m-6 4h4"></path></symbol
        >
        <symbol id="i-map" viewBox="0 0 24 24"
          ><circle cx="6" cy="17" r="2"></circle><circle cx="12" cy="6" r="2"></circle><circle
            cx="18"
            cy="16"
            r="2"></circle><path d="m7 15 4-7m2 0 4 6M8 17l8-1"></path></symbol
        >
        <symbol id="i-lock" viewBox="0 0 24 24"
          ><rect x="4" y="10" width="16" height="11" rx="2"></rect><path d="M8 10V7a4 4 0 0 1 8 0v3"
          ></path></symbol
        >
        <symbol id="i-check" viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"></path></symbol>
        <symbol id="i-update" viewBox="0 0 24 24"
          ><path d="M20 7v5h-5M4 17v-5h5"></path><path
            d="M6.1 8A7 7 0 0 1 18 6l2 6M17.9 16A7 7 0 0 1 6 18l-2-6"></path></symbol
        >
      </defs>
    </svg>

    <header class="site-nav">
      <a class="brand" href={`${projectBasePath}/`} aria-label="Dusori home">
        <picture>
          <source
            media="(prefers-color-scheme: dark)"
            srcset={`${projectBasePath}/brand/dusori-mark-reversed.svg`}
          />
          <img src={`${projectBasePath}/brand/dusori-mark.svg`} alt="" width="30" height="30" />
        </picture>
        <span>Dusori</span>
      </a>
      <nav aria-label="Primary">
        <a href={docsHref}>Docs</a>
      </nav>
      <a class="button button--small" href={appHref}>
        <svg aria-hidden="true"><use href="#i-browser"></use></svg> Open app
      </a>
    </header>

    <main>
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow"><span>v{releaseVersion}</span> Private learning studio</p>
          <h1 id="hero-title">A calm place for a difficult subject.</h1>
          <p class="lede">
            Dusori finds sources you permit, keeps only what you deliberately save, and gives you
            one clear next step. Your reading, notes, progress, and map stay on your device.
          </p>
          <div class="actions">
            <a class="button button--primary" href={appHref}
              ><svg aria-hidden="true"><use href="#i-browser"></use></svg> Open in browser</a
            >
            <a class="button" href="#downloads"
              ><svg aria-hidden="true"><use href="#i-download"></use></svg> Download app</a
            >
          </div>
          <p class="trust-line">
            No account · no telemetry · no hosted workspace · useful without AI
          </p>
        </div>
        <figure class="hero-figure">
          <img
            src={learnShot}
            alt="Dusori Learn view with one focused next step and four predictable destinations"
            width="1440"
            height="960"
            fetchpriority="high"
          />
          <figcaption>
            <span>Learn</span><span>One next step, derived from your files</span>
          </figcaption>
        </figure>
      </section>

      <section class="promise" aria-label="Dusori places">
        <p>Four places. No mystery drawers.</p>
        <dl>
          <div><dt>Learn</dt><dd>Continue the topic.</dd></div>
          <div><dt>Sources</dt><dd>Keep and read evidence.</dd></div>
          <div><dt>Map</dt><dd>See galaxy or Outline.</dd></div>
          <div><dt>Settings</dt><dd>Control files, privacy, updates.</dd></div>
        </dl>
      </section>

      <section class="loop" id="how" aria-labelledby="loop-title">
        <header class="section-heading">
          <p class="eyebrow">The daily loop</p>
          <h2 id="loop-title">From “I should study” to one honest action.</h2>
          <p>Dusori can route the next step. It cannot claim you learned it.</p>
        </header>
        <ol class="loop-steps">
          <li>
            <span>01</span><div>
              <h3>Continue</h3><p>
                Resume the next unfinished objective, a ready source, or a due review.
              </p>
            </div>
          </li>
          <li>
            <span>02</span><div>
              <h3>Read</h3><p>
                Open a source you deliberately saved. Previewing a result never adds it.
              </p>
            </div>
          </li>
          <li>
            <span>03</span><div>
              <h3>Annotate</h3><p>
                Write beside the evidence in Markdown that remains useful outside Dusori.
              </p>
            </div>
          </li>
          <li>
            <span>04</span><div>
              <h3>Mark learned or review</h3><p>
                Only your click changes the roadmap or review schedule.
              </p>
            </div>
          </li>
          <li>
            <span>05</span><div>
              <h3>See what changed</h3><p>
                The Map and Outline reflect the same files, links, sources, and tags.
              </p>
            </div>
          </li>
        </ol>
      </section>

      <section class="reader" aria-labelledby="reader-title">
        <figure>
          <img
            src={readerShot}
            alt="Dusori Reading room with a saved local source"
            width="1440"
            height="960"
            loading="lazy"
          />
          <figcaption>Reading room · a local copy with provenance</figcaption>
        </figure>
        <div>
          <p class="eyebrow">The evidence shelf</p>
          <h2 id="reader-title">You always know what was saved.</h2>
          <p>
            Search results are candidates. <strong>Preview</strong> lets you inspect one;
            <strong>Save source</strong> puts it on the shelf; <strong>Save & read</strong> opens its
            local reading copy. The Sources count comes from the portable manifest—not from a transient
            result list.
          </p>
          <ul>
            <li>
              <svg aria-hidden="true"><use href="#i-check"></use></svg> Provider, URL, author, date, and
              selection reason stay attached when available.
            </li>
            <li>
              <svg aria-hidden="true"><use href="#i-check"></use></svg> Failed providers remain failures
              in the research trail.
            </li>
            <li>
              <svg aria-hidden="true"><use href="#i-check"></use></svg> A source does not become progress
              until you say so.
            </li>
          </ul>
          <a class="text-link" href={`${docsHref}sources/`}
            >How sources work <svg aria-hidden="true"><use href="#i-arrow"></use></svg></a
          >
        </div>
      </section>

      <section class="map" aria-labelledby="map-title">
        <div>
          <p class="eyebrow">Galaxy + Outline</p>
          <h2 id="map-title">Zoom out without losing the path.</h2>
          <p>
            Explore an Obsidian-like constellation, then switch to the accessible linear Outline.
            Both are derived from your folders, notes, sources, tags, and <code>[[wikilinks]]</code
            >. No graph database sits between you and your files.
          </p>
          <a class="text-link" href={`${docsHref}knowledge-graph/`}
            >Read the graph contract <svg aria-hidden="true"><use href="#i-arrow"></use></svg></a
          >
        </div>
        <figure>
          <img
            src={mapShot}
            alt="Dusori Map with a galaxy view and matching linear outline"
            width="1440"
            height="960"
            loading="lazy"
          />
          <figcaption>Map · the same knowledge in two views</figcaption>
        </figure>
      </section>

      <section class="research" aria-labelledby="research-title">
        <header class="section-heading">
          <p class="eyebrow">Research with boundaries</p>
          <h2 id="research-title">A capable researcher that shows its work.</h2>
          <p>Each provider starts off. You see what it sends before the first request.</p>
        </header>
        <div class="research-ledger">
          <article>
            <span>Works directly</span><h3>Public knowledge</h3><p>
              Microsoft Learn, Wikipedia, OpenAlex, GitHub, Stack Overflow, Hacker News, and npm.
            </p>
          </article>
          <article>
            <span>Local companion</span><h3>Broader discovery</h3><p>
              arXiv, Reddit, general web search, and YouTube metadata through your API key or an
              optional self-hosted fallback.
            </p>
          </article>
          <article>
            <span>Optional</span><h3>AI assistance</h3><p>
              Local Ollama or your hosted-provider key. Model output is labeled; deterministic paths
              remain.
            </p>
          </article>
        </div>
        <p class="legal-note">
          Dusori does not bypass logins, paywalls, robots controls, or platform restrictions, and it
          does not download YouTube media. Third-party terms and quotas still apply.
          <a href={`${docsHref}research-providers/`}>Provider matrix →</a>
        </p>
      </section>

      <section class="downloads" id="downloads" aria-labelledby="downloads-title">
        <header class="section-heading">
          <p class="eyebrow">Choose your door</p>
          <h2 id="downloads-title">Browser, Mac, Windows, or source.</h2>
          <p>
            Desktop artifacts and checksums are listed together on the v{releaseVersion} release page.
          </p>
        </header>
        <div class="download-grid">
          <article class="download-card featured">
            <svg aria-hidden="true"><use href="#i-browser"></use></svg>
            <h3>Browser</h3><p>No account or terminal. Install as a PWA where supported.</p>
            <a href={appHref}
              >Open Dusori <svg aria-hidden="true"><use href="#i-arrow"></use></svg></a
            >
          </article>
          <article class="download-card">
            <span class="platform">macOS</span><h3>Apple silicon</h3><p>
              For M-series Macs. macOS 12 or newer.
            </p>
            <a href={releaseHref}
              >Release downloads <svg aria-hidden="true"><use href="#i-arrow"></use></svg></a
            >
          </article>
          <article class="download-card">
            <span class="platform">macOS</span><h3>Intel</h3><p>
              For Intel Macs. macOS 12 or newer.
            </p>
            <a href={releaseHref}
              >Release downloads <svg aria-hidden="true"><use href="#i-arrow"></use></svg></a
            >
          </article>
          <article class="download-card">
            <span class="platform">Windows</span><h3>x64</h3><p>
              Current-user installer for 64-bit Windows.
            </p>
            <a href={releaseHref}
              >Release downloads <svg aria-hidden="true"><use href="#i-arrow"></use></svg></a
            >
          </article>
          <article class="download-card code-card">
            <span class="platform">Node.js 24</span><h3>
              Local companion
            </h3><pre><code>npx @udhawan97/dusori@latest</code></pre>
            <a href={`${docsHref}getting-started/`}
              >Setup guide <svg aria-hidden="true"><use href="#i-arrow"></use></svg></a
            >
          </article>
          <article class="download-card">
            <span class="platform">Apache 2.0</span><h3>Source</h3><p>
              Audit, change, or build the exact v{releaseVersion} tree.
            </p>
            <a href={sourceHref}
              >Source ZIP <svg aria-hidden="true"><use href="#i-arrow"></use></svg></a
            >
          </article>
        </div>
        <aside class="warning">
          <strong>First-launch warning</strong>
          <p>
            The v{releaseVersion} Mac and Windows installers are not Apple-notarized or Microsoft code-signed,
            so Gatekeeper or SmartScreen may warn. Compare the download with
            <code>SHA256SUMS.txt</code>. The separate in-app updater artifacts are signed by
            Dusori's updater key.
          </p>
        </aside>
      </section>

      <section class="updates" aria-labelledby="updates-title">
        <div class="update-mark"><svg aria-hidden="true"><use href="#i-update"></use></svg></div>
        <div>
          <p class="eyebrow">Desktop updates</p>
          <h2 id="updates-title">Check. Download. Choose when to restart.</h2>
          <p>
            Settings can check GitHub on demand, or opt in to automatic checks and downloads at app
            startup. Dusori verifies the update signature, shows the version and notes, then waits.
            Nothing installs or relaunches until you choose <strong>Install and restart</strong>;
            unsaved work blocks it.
          </p>
          <a class="text-link" href={`${docsHref}updates/`}
            >Update and recovery guide <svg aria-hidden="true"><use href="#i-arrow"></use></svg></a
          >
        </div>
      </section>

      <section class="ownership" aria-labelledby="ownership-title">
        <div>
          <p class="eyebrow">Portable by default</p>
          <h2 id="ownership-title">The exit is the same door as the entrance.</h2>
          <p>
            Markdown, text, JSON, HTML, folders, and ZIPs. Use them in Obsidian, a text editor, or
            your own tools.
          </p>
        </div>
        <pre
          aria-label="Dusori workspace structure"><code>Topics/your-topic/
├── roadmap.md
├── Notes/
├── Sources/
│   ├── manifest.json
│   └── items/
├── research.json
└── Updates/</code></pre>
      </section>
    </main>

    <footer class="site-footer">
      <div><strong>Dusori</strong><span>Your files stay yours.</span></div>
      <nav aria-label="Project">
        <a href={docsHref}>Docs</a><a href={githubHref}>GitHub</a><a href={releaseHref}
          >v{releaseVersion}</a
        ><a href={`${githubHref}/blob/main/LICENSE`}>Apache 2.0</a>
      </nav>
    </footer>
  </body>
</html>
