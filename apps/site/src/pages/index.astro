---
import '../styles/global.css';
import '../styles/landing.css';

import {
  appBasePath,
  docsBasePath,
  hostedProjectUrl,
  projectBasePath,
} from '../../../../config/site.mjs';

const releaseVersion = '0.11.1';
const appHref = `${appBasePath}/`;
const docsHref = `${docsBasePath}/`;
const gettingStartedHref = `${docsHref}getting-started/`;
const browserSupportHref = `${docsHref}browser-support/`;
const learningLoopHref = `${docsHref}learning-loop/`;
const graphHref = `${docsHref}knowledge-graph/`;
const workspacesHref = `${docsHref}workspaces/`;
const githubHref = 'https://github.com/udhawan97/Dusori';
const releaseHref = `${githubHref}/releases/tag/v${releaseVersion}`;
const sourceZipHref = `${githubHref}/archive/refs/tags/v${releaseVersion}.zip`;
const licenseHref = `${githubHref}/blob/main/LICENSE`;
const graphShotHref = `${projectBasePath}/app-graph.png`;
const researchShotHref = `${projectBasePath}/app-research.png`;
const workspaceShotHref = `${projectBasePath}/app-workspace.png`;
const curriculumShotHref = `${projectBasePath}/app-curriculum.png`;
const socialImageHref = `${hostedProjectUrl}og-dusori.png`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; base-uri 'self'; object-src 'none'; img-src 'self'; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    />
    <meta name="theme-color" content="#f7f1e8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14100d" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={`${projectBasePath}/favicon.svg`} type="image/svg+xml" />
    <link rel="canonical" href={hostedProjectUrl} />
    <meta
      name="description"
      content="Tell Dusori what you want to understand. It researches the sources you allow, keeps the evidence trail, and stays entirely on your device."
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Dusori — research it, understand it, keep the files" />
    <meta
      property="og:description"
      content="A private research workbench built from ordinary files. It finds sources, keeps the evidence trail, and teaches from what you approve. No account, no telemetry, useful without AI."
    />
    <meta property="og:url" content={hostedProjectUrl} />
    <meta property="og:image" content={socialImageHref} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Dusori research view on a dark local learning desk" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>Dusori — research it, understand it, keep the files</title>
  </head>
  <body>
    <svg class="icon-defs" aria-hidden="true" focusable="false">
      <defs>
        <symbol id="icon-arrow" viewBox="0 0 24 24">
          <path d="M5 12h13M14 7l5 5-5 5"></path>
        </symbol>
        <symbol id="icon-browser" viewBox="0 0 24 24">
          <rect x="3" y="4" width="18" height="16" rx="2"></rect>
          <path d="M3 8h18M6 6h.01M9 6h.01"></path>
        </symbol>
        <symbol id="icon-download" viewBox="0 0 24 24">
          <path d="M12 3v12M7 10l5 5 5-5M4 19h16"></path>
        </symbol>
        <symbol id="icon-terminal" viewBox="0 0 24 24">
          <rect x="3" y="4" width="18" height="16" rx="2"></rect>
          <path d="m7 9 3 3-3 3M13 15h4"></path>
        </symbol>
        <symbol id="icon-book" viewBox="0 0 24 24">
          <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H11v16H6.5A2.5 2.5 0 0 0 4 21.5z"></path>
          <path d="M20 5.5A2.5 2.5 0 0 0 17.5 3H13v16h4.5a2.5 2.5 0 0 1 2.5 2.5z"></path>
        </symbol>
        <symbol id="icon-source" viewBox="0 0 24 24">
          <path d="M6 3h8l4 4v14H6zM14 3v4h4M9 12h6M9 16h4"></path>
        </symbol>
        <symbol id="icon-review" viewBox="0 0 24 24">
          <path d="M6 5h12M6 12h8M6 19h5"></path>
          <path d="m16 16 2 2 4-5"></path>
        </symbol>
        <symbol id="icon-graph" viewBox="0 0 24 24">
          <circle cx="6" cy="17" r="2"></circle>
          <circle cx="12" cy="6" r="2"></circle>
          <circle cx="18" cy="16" r="2"></circle>
          <path d="m7 15 4-7m2 0 4 6M8 17l8-1"></path>
        </symbol>
        <symbol id="icon-lock" viewBox="0 0 24 24">
          <rect x="4" y="10" width="16" height="11" rx="2"></rect>
          <path d="M8 10V7a4 4 0 0 1 8 0v3M12 14v3"></path>
        </symbol>
        <symbol id="icon-folder" viewBox="0 0 24 24">
          <path d="M3 7a1 1 0 0 1 1-1h5l2 2h9a1 1 0 0 1 1 1v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"
          ></path>
        </symbol>
        <symbol id="icon-pdf" viewBox="0 0 24 24">
          <path d="M6 3h8l4 4v14H6zM14 3v4h4"></path>
          <path
            d="M8.5 16v-4h1.2a1.2 1.2 0 0 1 0 2.4H8.5m4 1.6v-4h1.1a2 2 0 0 1 0 4zm4 0v-4h2.5m-2.5 2h2"
          ></path>
        </symbol>
      </defs>
    </svg>

    <header class="site-nav">
      <a class="nav-brand" href={`${projectBasePath}/`} aria-label="Dusori home">
        <picture>
          <source
            media="(prefers-color-scheme: dark)"
            srcset={`${projectBasePath}/brand/dusori-mark-reversed.svg`}
          />
          <img src={`${projectBasePath}/brand/dusori-mark.svg`} alt="" width="28" height="28" />
        </picture>
        <span>Dusori</span>
      </a>
      <a class="button button--nav" href={appHref}>
        <svg aria-hidden="true"><use href="#icon-browser"></use></svg>
        Open app
      </a>
    </header>

    <main>
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <div class="hero-signature">
            <picture class="hero-mark">
              <source
                media="(prefers-reduced-motion: reduce) and (prefers-color-scheme: dark)"
                srcset={`${projectBasePath}/brand/dusori-mark-reversed.svg`}
              />
              <source
                media="(prefers-reduced-motion: reduce) and (prefers-color-scheme: light)"
                srcset={`${projectBasePath}/brand/dusori-mark.svg`}
              />
              <source
                media="(prefers-color-scheme: dark)"
                srcset={`${projectBasePath}/brand/dusori-mark-animated-reversed.svg`}
              />
              <img
                src={`${projectBasePath}/brand/dusori-mark-animated.svg`}
                alt="Dusori ensō, rangoli, and katana mark"
                width="80"
                height="80"
              />
            </picture>
            <a href={releaseHref}>v{releaseVersion} available now</a>
          </div>
          <h1 id="hero-title">Tell it what you<br />want to understand.</h1>
          <p class="hero-lede">
            Dusori searches the sources you allow, keeps the evidence trail, and turns what you
            approve into a synthesis you can learn from — entirely on your device, in formats you
            can open without Dusori.
          </p>
          <div class="hero-actions">
            <a class="button button--primary" href={appHref}>
              <svg aria-hidden="true"><use href="#icon-browser"></use></svg>
              Open Dusori
            </a>
            <a class="button button--secondary" href={sourceZipHref}>
              <svg aria-hidden="true"><use href="#icon-download"></use></svg>
              Download source ZIP
            </a>
          </div>
          <p class="hero-trust">
            No account · no telemetry · no hosted database · useful without AI
          </p>
        </div>

        <figure class="hero-proof">
          <img
            src={researchShotHref}
            alt="Dusori research view: one of seven providers allowed, quoted passages read from an approved source, and a per-topic freshness setting"
            width="1280"
            height="900"
            fetchpriority="high"
          />
          <figcaption>
            <span>Real app · research mission</span>
            <span>Browser workspace · private</span>
          </figcaption>
        </figure>
      </section>

      <section class="start" id="start" aria-labelledby="start-title">
        <header class="section-head">
          <h2 id="start-title">Start where you are.</h2>
          <p>
            The browser is the simplest route. Download the source when you want the current release
            on your own machine.
          </p>
        </header>

        <div class="start-grid">
          <article class="start-option start-option--featured">
            <svg class="option-icon" aria-hidden="true"><use href="#icon-browser"></use></svg>
            <div>
              <h3>Use it in your browser</h3>
              <p>
                No terminal and no account. Where supported, install it from the browser for offline
                use.
              </p>
            </div>
            <a class="option-link" href={appHref}>
              Open app <svg aria-hidden="true"><use href="#icon-arrow"></use></svg>
            </a>
          </article>

          <article class="start-option">
            <svg class="option-icon" aria-hidden="true"><use href="#icon-download"></use></svg>
            <div>
              <h3>Download v{releaseVersion}</h3>
              <p>Get the exact current source as a ZIP. Node.js 24 LTS is required to run it.</p>
            </div>
            <a class="option-link" href={sourceZipHref}>
              Download ZIP <svg aria-hidden="true"><use href="#icon-arrow"></use></svg>
            </a>
          </article>

          <article class="start-option">
            <svg class="option-icon" aria-hidden="true"><use href="#icon-terminal"></use></svg>
            <div>
              <h3>Run it locally</h3>
              <p>With Node.js 24, one command downloads and opens the current release.</p>
            </div>
            <a class="option-link" href="#run-locally">
              See setup <svg aria-hidden="true"><use href="#icon-arrow"></use></svg>
            </a>
          </article>
        </div>

        <p class="package-note">
          The npm companion now matches v{releaseVersion}. Run <code
            >npx @udhawan97/dusori@latest</code
          > to open the same current app without a global install.
        </p>
      </section>

      <section class="tour" aria-labelledby="tour-title">
        <header class="section-head section-head--wide">
          <h2 id="tour-title">A desk that reads the evidence.</h2>
          <p>
            Dusori does not invent urgency or pretend you mastered something. It reads the files you
            have, then gives you a clear next doorway.
          </p>
        </header>

        <article class="tour-block tour-block--today">
          <figure class="product-capture product-capture--wide">
            <img
              src={workspaceShotHref}
              alt="Dusori Today view with evidence-backed learning and attention lanes"
              width="1440"
              height="960"
              loading="lazy"
            />
          </figure>
          <div class="capture-notes" aria-label="Today view details">
            <div>
              <svg aria-hidden="true"><use href="#icon-book"></use></svg>
              <h3>Continue learning</h3>
              <p>Resume a review, a ready source, or the next unfinished objective.</p>
            </div>
            <div>
              <svg aria-hidden="true"><use href="#icon-review"></use></svg>
              <h3>Needs attention</h3>
              <p>See only decisions supported by current local evidence.</p>
            </div>
            <div>
              <svg aria-hidden="true"><use href="#icon-lock"></use></svg>
              <h3>Nothing silent</h3>
              <p>Opening Today never changes progress or schedules a review.</p>
            </div>
          </div>
          <a class="text-link" href={learningLoopHref}>How the learning loop works →</a>
        </article>

        <article class="tour-split">
          <div class="tour-copy">
            <svg class="tour-icon" aria-hidden="true"><use href="#icon-pdf"></use></svg>
            <h2>A source becomes a roadmap—after you approve it.</h2>
            <p>
              Paste an outline or open an AWS Certification exam guide PDF. Dusori reads the file on
              your device, fills the outline, and lets you edit the result before it writes the
              roadmap.
            </p>
            <ul class="plain-list" role="list">
              <li>PDF text stays on your device.</li>
              <li>Scanned PDFs say when no text layer exists.</li>
              <li>Preview comes before apply.</li>
            </ul>
            <a class="text-link" href={`${docsHref}curricula/`}>Read the curriculum guide →</a>
          </div>
          <figure class="product-capture product-capture--portrait">
            <img
              src={curriculumShotHref}
              alt="Dusori curriculum preview showing Microsoft Learn roadmap items before the user applies them"
              width="303"
              height="729"
              loading="lazy"
            />
            <figcaption>Real Microsoft guide preview · nothing applied yet</figcaption>
          </figure>
        </article>

        <article class="tour-split tour-split--reverse">
          <div class="tour-copy">
            <svg class="tour-icon" aria-hidden="true"><use href="#icon-graph"></use></svg>
            <h2>Your notes stay on speaking terms.</h2>
            <p>
              The graph comes from folders, Markdown, frontmatter, and wikilinks. Search it, filter
              it, and find unresolved links—without creating a graph database you have to export
              from later.
            </p>
            <ul class="plain-list" role="list">
              <li>Backlinks reverse real resolved links.</li>
              <li>Layout settings stay outside your workspace files.</li>
              <li>The same Markdown works in Obsidian.</li>
            </ul>
            <a class="text-link" href={graphHref}>See the portable graph contract →</a>
          </div>
          <figure class="product-capture product-capture--graph">
            <img
              src={graphShotHref}
              alt="Dusori knowledge constellation built from portable local artifacts"
              width="2880"
              height="1800"
              loading="lazy"
            />
            <figcaption>Real graph view · files in, relationships out</figcaption>
          </figure>
        </article>
      </section>

      <section class="workflow" aria-labelledby="workflow-title">
        <header class="section-head">
          <h2 id="workflow-title">One loop, four honest steps.</h2>
          <p>Each step leaves you with an ordinary file or an explicit decision.</p>
        </header>
        <ol class="steps">
          <li>
            <span class="step-number">1</span>
            <h3>Name what you want to understand.</h3>
            <p>Dusori opens a research mission for that topic and prepares its first scan.</p>
          </li>
          <li>
            <span class="step-number">2</span>
            <h3>Choose the evidence.</h3>
            <p>
              Providers stay off until you allow them, each naming what it sends. The trail records
              what every provider returned — or failed to return.
            </p>
          </li>
          <li>
            <span class="step-number">3</span>
            <h3>Read what you kept.</h3>
            <p>
              Approved sources become verbatim quoted passages and a synthesis where every quoted
              passage cites its source and thin evidence is marked as thin.
            </p>
          </li>
          <li>
            <span class="step-number">4</span>
            <h3>Learn from it, and keep it.</h3>
            <p>
              Build an optional interactive learning page, then keep everything as Markdown, JSON,
              and HTML you can read anywhere.
            </p>
          </li>
        </ol>
      </section>

      <section class="ownership" aria-labelledby="ownership-title">
        <div class="ownership-copy">
          <svg class="tour-icon" aria-hidden="true"><use href="#icon-folder"></use></svg>
          <h2 id="ownership-title">Your workspace stays useful without Dusori.</h2>
          <p>
            Browser storage is private to this site. Supported desktop browsers can connect one
            folder you choose. ZIP import and export remain the universal way in and out.
          </p>
          <div class="ownership-links">
            <a class="text-link" href={workspacesHref}>Workspace choices →</a>
            <a class="text-link" href={browserSupportHref}>Browser support →</a>
          </div>
        </div>
        <pre
          aria-label="Dusori workspace file structure"><code>Dusori/
├── Home.md
├── dusori.json
└── Topics/
    └── your-topic/
        ├── roadmap.md
        ├── TUTOR.md
        ├── Notes/
        ├── Sources/
        └── state.json</code></pre>
      </section>

      <section class="capabilities" aria-labelledby="capabilities-title">
        <header class="section-head section-head--wide">
          <h2 id="capabilities-title">The useful parts, in plain English.</h2>
          <p>Everything below is in the current build. Optional network tools stay optional.</p>
        </header>
        <dl class="capability-ledger">
          <div>
            <dt>Research</dt>
            <dd>
              Asks before each provider can search, shows why each result surfaced, and keeps a
              durable trail of every run — including the ones that failed.
            </dd>
          </div>
          <div>
            <dt>Synthesis</dt>
            <dd>
              Reads approved sources into verbatim quoted passages, then writes a cited synthesis
              that marks what only one source claims.
            </dd>
          </div>
          <div>
            <dt>Learn</dt>
            <dd>
              Builds an optional self-contained learning page from those passages. Read it inside
              Dusori, or open the file without Dusori.
            </dd>
          </div>
          <div>
            <dt>Keep a topic fresh</dt>
            <dd>
              Optional, per topic: re-scan when you open it after seven days, using only the
              providers you already allowed. Nothing runs while Dusori is closed.
            </dd>
          </div>
          <div>
            <dt>Today</dt>
            <dd>Opens with your research missions and the next evidence-backed action.</dd>
          </div>
          <div>
            <dt>Review</dt>
            <dd>Builds active-recall prompts from sources you approved.</dd>
          </div>
          <div>
            <dt>Roadmaps</dt>
            <dd>Turns outlines and supported exam-guide PDFs into reviewable Markdown plans.</dd>
          </div>
          <div>
            <dt>Search + graph</dt>
            <dd>Finds local text, tags, backlinks, hubs, and unresolved wikilinks.</dd>
          </div>
          <div>
            <dt>Conflict safety</dt>
            <dd>Proposes a new Markdown version when another editor changed the file first.</dd>
          </div>
          <div>
            <dt>Portability</dt>
            <dd>Imports and exports a whole workspace ZIP or one topic bundle.</dd>
          </div>
        </dl>
      </section>

      <section class="final-cta" id="run-locally" aria-labelledby="final-title">
        <div class="final-copy">
          <h2 id="final-title">Take the browser door, or take the files.</h2>
          <p>
            Open Dusori immediately, or download v{releaseVersion} and run the same current app locally
            with Node.js 24 LTS.
          </p>
          <div class="hero-actions">
            <a class="button button--primary" href={appHref}>
              <svg aria-hidden="true"><use href="#icon-browser"></use></svg>
              Open app
            </a>
            <a class="button button--secondary" href={sourceZipHref}>
              <svg aria-hidden="true"><use href="#icon-download"></use></svg>
              Download source ZIP
            </a>
          </div>
        </div>
        <div class="run-command">
          <p>
            <svg aria-hidden="true"><use href="#icon-terminal"></use></svg>
            With Node.js 24 LTS
          </p>
          <pre><code>npx @udhawan97/dusori@latest</code></pre>
          <span
            >Downloads and opens the current release. Nothing stays running after you close the
            terminal.</span
          >
          <a class="text-link" href={gettingStartedHref}>Full setup guide →</a>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <span class="footer-brand">Dusori · Apache 2.0</span>
      <nav aria-label="Project">
        <a href={docsHref}>Docs</a>
        <a href={githubHref}>GitHub</a>
        <a href={releaseHref}>v{releaseVersion}</a>
        <a href={licenseHref}>License</a>
      </nav>
      <span>Your files stay yours.</span>
    </footer>
  </body>
</html>
