{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dusori",
  "version": "0.12.4",
  "identifier": "io.github.udhawan97.dusori",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-src 'self' blob:; worker-src 'self' blob:; img-src 'self' data: blob: http://127.0.0.1:*; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* https://learn.microsoft.com https://en.wikipedia.org https://hn.algolia.com https://api.github.com https://api.stackexchange.com https://api.openalex.org https://api.crossref.org https://openlibrary.org https://registry.npmjs.org",
      "capabilities": ["main-window"],
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Education",
    "copyright": "Copyright Dusori contributors",
    "shortDescription": "A local-first learning studio",
    "longDescription": "Research, read, annotate, and follow a source-backed learning path without an account.",
    "resources": {
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../resources/companion.cjs": "resources/companion.cjs",
      "../resources/node-*": "resources/",
      "../resources/NODE_LICENSE": "resources/NODE_LICENSE"
    },
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "dmg": {
        "background": "dmg/background.png",
        "windowSize": { "width": 720, "height": 460 },
        "appPosition": { "x": 180, "y": 230 },
        "applicationFolderPosition": { "x": 540, "y": 230 }
      }
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": ["https://github.com/udhawan97/Dusori/releases/latest/download/latest.json"],
      "dialog": false,
      "pubkey": "DUSORI_UPDATER_PUBLIC_KEY_NOT_PROVISIONED"
    }
  }
}
